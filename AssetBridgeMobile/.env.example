# Set the reachable API URL for your environment. Do not rely on a developer machine's IP.
# Do not put Supabase service-role keys in this file.
EXPO_PUBLIC_API_URL=

# Sepolia WDK configuration. Use endpoints and token contracts verified for your deployment.
# EXPO_PUBLIC_* values are bundled into the app; never put private provider keys here.
EXPO_PUBLIC_SEPOLIA_RPC_URL=
EXPO_PUBLIC_SEPOLIA_BUNDLER_URL=
EXPO_PUBLIC_SEPOLIA_PAYMASTER_URL=
EXPO_PUBLIC_SEPOLIA_PAYMASTER_ADDRESS=
EXPO_PUBLIC_SEPOLIA_PAYMASTER_TOKEN_ADDRESS=
EXPO_PUBLIC_SEPOLIA_SAFE_MODULES_VERSION=
EXPO_PUBLIC_SEPOLIA_USDT_CONTRACT_ADDRESS=
EXPO_PUBLIC_SEPOLIA_USDT_DECIMALS=

# For a physical phone, use the computer's LAN IP address on the same Wi-Fi.
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.20:5000/api
# Do not put Supabase service-role keys in this file.
EXPO_PUBLIC_API_URL=http://192.168.1.20:5000/api
# Sepolia RPC and ERC-4337 bundler endpoints. Public defaults are in src/config/wdk.js;
# supply dedicated provider endpoints for dependable builds and demos.
EXPO_PUBLIC_SEPOLIA_RPC_URL=
EXPO_PUBLIC_SEPOLIA_BUNDLER_URL=
# Defaults to the starter's documented Sepolia test USDT contract address.
EXPO_PUBLIC_SEPOLIA_USDT_ADDRESS=

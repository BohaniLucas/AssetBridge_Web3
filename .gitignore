# Dependencies (never commit node_modules)
node_modules/
**/node_modules/

# Environment files and secrets (never commit keys)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Production builds
dist/
dist-ssr/
build/
out/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


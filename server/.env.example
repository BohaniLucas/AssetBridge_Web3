# =====================================================================
# AssetBridge Server Environment Configuration (.env.example)
# =====================================================================

# Server Port & Whitelisted Client URL
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Development Test Account (MUST be false in production; fails closed if NODE_ENV=production)
ENABLE_DEV_TEST_ACCOUNT=false

# Supabase Persistence & Authentication (Optional for cloud sync)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Tether Blockchain & Smart Contract Escrow Configuration
TETHER_NETWORK=Sepolia
TETHER_RPC_URL=https://rpc.sepolia.org
TETHER_USDT_CONTRACT_ADDRESS=0x7169D38820dfd117C3FA1f22a697dBA58d90BA06

# Live Market Data Providers
# Finnhub (Real-time US stocks/equities - register free at https://finnhub.io)
FINNHUB_API_KEY=your_finnhub_api_key_here

# open.er-api.com (166 currency Forex rates - public, no API key required)
OPEN_ER_API_BASE_URL=https://open.er-api.com/v6/latest/USD

# Binance Public Market Feeds (Crypto tickers - public, no API key required)
BINANCE_API_BASE_URL=https://api.binance.com/api/v3

# Cryptographic Quote Signing Secret (HMAC-SHA256 for quote integrity)
QUOTE_SIGNING_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# Remittance & Gogo Claim Escrow / Payout Partner Configuration (Server-Side Only)
ASSETBRIDGE_ESCROW_ADDRESS=0x7169D38820dfd117C3FA1f22a697dBA58d90BA06
PAYSHAP_PROVIDER_BASE_URL=
PAYSHAP_PROVIDER_API_KEY=
PAYOUT_WEBHOOK_SECRET=replace-with-provider-webhook-hmac-secret
OTP_PROVIDER_API_KEY_SID=
OTP_PROVIDER_API_KEY_SECRET=
OTP_PROVIDER_API_KEY_SECRETE=
OTP_PROVIDER_API_KEY=
